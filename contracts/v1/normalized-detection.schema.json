{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "source_id", "event_type", "occurred_at", "confidence", "model_id", "model_version"],
  "properties": {
    "signal_id": {"type": "string"},
    "source_id": {"type": "string"},
    "event_type": {"enum": ["SMOKING_CANDIDATE", "SMOKING_CONFIRMED", "DETECTION_CLEARED"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "candidate_age_band": {"enum": ["YOUNG_ADULT", "MIDDLE_AGE", "OLDER_ADULT", "GENERAL", null]},
    "model_id": {"type": "string"},
    "model_version": {"type": "string"}
  }
}
